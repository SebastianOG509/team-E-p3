// Model (M1) of the Fluvial Transportation System (FTS): starting structure of Delivery 1, with the properties of Delivery 2
// Generated by tools/gen_models.py from the tables of Delivery 2 and from sos.arch.
system FTS

constituent CPS "Sistema de Gestión de Puertos del Caribe" owner "Operadores portuarios de la costa Caribe"
constituent PPS "Sistema de Gestión de Puertos del Pacífico" owner "Operadores portuarios de la costa Pacífica"
constituent RTS "Sistema de Transporte Carretero" owner "Empresas transportadoras y operadores de flotas"
constituent RLS "Sistema de Transporte Férreo" owner "Concesionarios férreos"
constituent FTS "Sistema de Transporte Fluvial" owner "Operadores de navegación fluvial"
constituent NCS "Sistema de Coordinación Nacional" owner "Autoridad nacional (transporte, aduanas y control)"

// Components of the FTS, by tier
// T1
component PAN "Panel del Operador Fluvial" in FTS tier T1 kind software
component CAP "App del Capitán" in FTS tier T1 kind software
component TMU "Terminal de Operación de Muelle" in FTS tier T1 kind software
// T2
component FGW "Fluvial Gateway" in FTS tier T2 kind software
component TRA "Traductor de Modelo Canónico" in FTS tier T2 kind software availability 99.5
component BRO "Broker Interno de Eventos" in FTS tier T2 kind software role broker
component IOT "Gateway IoT de Campo" in FTS tier T2 kind hardware
// T3
component PRO "Servicio de Programación de Viajes" in FTS tier T3 kind software
component TUR "Servicio de Turnos de Transferencia" in FTS tier T3 kind software
component CUS "Servicio de Custodia" in FTS tier T3 kind software
component SEG "Servicio de Seguimiento de Flota" in FTS tier T3 kind software
component CON "Servicio de Consulta de Estado" in FTS tier T3 kind software latency 30000
// T4
component BOF "Base de Operaciones Fluvial" in FTS tier T4 kind software
component ALT "Almacén de Telemetría" in FTS tier T4 kind software
// T5
component UAB "Unidad a Bordo GPS/AIS" in FTS tier T5 kind hardware
component SEN "Sensor de Carga y Sello" in FTS tier T5 kind physical
component GRU "Grúa del Terminal Fluvial" in FTS tier T5 kind physical
component BAR "Barcaza" in FTS tier T5 kind physical
component REM "Remolcador" in FTS tier T5 kind physical
// T2 — boundary components of the other constituents (as in sos.arch)
component CGW "Caribbean Port Gateway" in CPS tier T2 kind software latency 300000
component PGW "Pacific Port Gateway" in PPS tier T2 kind software
component RGW "Road Gateway" in RTS tier T2 kind software latency 200000
component LGW "Rail Gateway" in RLS tier T2 kind software
component NCG "National Coordination Gateway" in NCS tier T2 kind software latency 230000

// Global connectors of the FTS (as in sos.arch)
connector SoS_K4a nature dependency coupling blocking
  carries "Solicitud de capacidad y turno de transferencia camión-barcaza"
  agreement "Contrato de transferencia camión-barcaza (v1)"
  : RGW -> FGW
connector SoS_K4b nature data_flow coupling blocking
  carries "Confirmación de muelle fluvial y horario, o rechazo"
  agreement "Contrato de transferencia camión-barcaza (v1)"
  : FGW -> RGW
connector SoS_K10a nature dependency coupling blocking
  carries "Arribo de barcaza y solicitud de muelle de transferencia"
  agreement "Contrato de transferencia puerto-barcaza (v1, v2)"
  : FGW -> CGW
connector SoS_K10b nature data_flow coupling blocking
  carries "Asignación de muelle de transferencia y ventana, o rechazo"
  agreement "Contrato de transferencia puerto-barcaza (v1, v2)"
  : CGW -> FGW
connector SoS_K15 nature event_notification coupling sink
  carries "Custodia recibida por el operador fluvial"
  agreement "Semántica de custodia; clave transferId (P8)"
  : FGW -> NCG
connector SoS_K16 nature event_notification coupling supply
  carries "Posición de barcaza o remolcador y estado de navegación"
  agreement "Reporte de posición; umbral P6 y clave P8"
  : FGW -> NCG
connector SoS_K19a nature dependency coupling blocking
  carries "Consulta de estado consolidado de la carga en la que participa el operador fluvial"
  agreement "Contrato de estado consolidado; regla de acceso y tasa P7"
  : FGW -> NCG
connector SoS_K19b nature data_flow coupling blocking
  carries "Estado consolidado limitado a su carga; v3: posición y ETA estimadas"
  agreement "Contrato de estado consolidado; regla de acceso y tasa P7"
  : NCG -> FGW
connector SoS_K28a nature dependency coupling blocking
  carries "Solicitud de camiones para retirar unidades en puerto fluvial"
  agreement "Contrato de retiro por camión (v1)"
  : FGW -> RGW
connector SoS_K28b nature data_flow coupling blocking
  carries "Vehículos asignados y cita de retiro, o rechazo"
  agreement "Contrato de retiro por camión (v1)"
  : RGW -> FGW
connector SoS_K31a nature dependency coupling blocking
  carries "Unidades liberadas para transferencia patio-barcaza y solicitud de capacidad"
  agreement "Contrato de transferencia puerto-barcaza (v1, v2)"
  : CGW -> FGW
connector SoS_K31b nature data_flow coupling blocking
  carries "Barcazas asignadas, muelle y ventana de cargue, o rechazo"
  agreement "Contrato de transferencia puerto-barcaza (v1, v2)"
  : FGW -> CGW
connector SoS_K35 nature event_notification coupling sink
  carries "Estado de servicio de un constituyente: degradado o restablecido"
  agreement "Aviso de estado de servicio (P2)"
  : NCG -> FGW
// Global connectors outside the FTS, only to compose the budgets of SoS-QS1 (M4) as in sos.arch
connector SoS_K5 nature event_notification coupling sink
  carries "Custodia recibida por el transportador; v3: ETA al despachar"
  agreement "Semántica de custodia; clave transferId (P8)"
  latency 40000
  : RGW -> NCG
connector SoS_K32 nature event_notification coupling sink
  carries "Cambio de levante en puertos del Caribe; v3: estado de servicio"
  agreement "Aviso de levante y de estado de servicio (v2, P2)"
  latency 10000
  : NCG -> CGW

// Internal connectors of the FTS
connector E_K1 nature dependency coupling blocking
  carries "Solicitud de turno de transferencia en formato canónico (llega por SoS-K4a)."
  : FGW -> TRA
connector E_K2 nature dependency coupling blocking
  carries "Solicitud de turno en modelo interno."
  : TRA -> TUR
connector E_K3 nature dependency coupling blocking
  carries "Consulta de disponibilidad de muelle y barcaza."
  : TUR -> BOF
connector E_K4 nature data_flow coupling blocking
  carries "Disponibilidad y programación vigente."
  : BOF -> TUR
connector E_K5 nature data_flow coupling sink
  carries "Registro del turno asignado."
  : TUR -> BOF
connector E_K6 nature data_flow coupling blocking
  carries "Muelle y horario asignados."
  : TUR -> TRA
connector E_K7 nature data_flow coupling blocking
  carries "Confirmación de turno en formato canónico (sale por SoS-K4b)."
  : TRA -> FGW
connector E_K8 nature dependency coupling blocking
  carries "Arribo estimado y solicitud de atraque."
  : PRO -> TRA
connector E_K9 nature dependency coupling blocking
  carries "Solicitud de atraque en formato canónico (sale por SoS-K10a)."
  : TRA -> FGW
connector E_K10 nature data_flow coupling blocking
  carries "Asignación de muelle y ventana operativa (llega por SoS-K10b)."
  : FGW -> TRA
connector E_K11 nature data_flow coupling blocking
  carries "Asignación de muelle y ventana en modelo interno."
  : TRA -> PRO
connector E_K12 nature data_flow coupling sink
  carries "Registro del viaje con muelle y ventana asignados."
  : PRO -> BOF
connector E_K13 nature dependency coupling blocking
  carries "Creación o cambio de viajes y asignación de barcazas."
  : PAN -> PRO
connector E_K14 nature data_flow coupling blocking
  carries "Itinerario y estado de los viajes."
  : PRO -> PAN
connector E_K15 nature data_flow coupling supply
  carries "Itinerario y ventana de atraque."
  : PRO -> CAP
connector E_K16 nature data_flow coupling supply
  carries "Turnos de transferencia programados."
  : TUR -> TMU
connector E_K17 nature data_flow coupling sink
  carries "Movimientos de carga ejecutados."
  : GRU -> IOT
connector E_K18 nature data_flow coupling supply
  carries "Estado del sello y lecturas de carga."
  : SEN -> IOT
connector E_K19 nature event_notification coupling sink
  carries "Traspaso de carga registrado (emisor, receptor, estado del sello declarado por el operador de muelle)."
  latency 10
  : TMU -> CUS
connector E_K20 nature data_flow coupling sink
  carries "Registro de custodia."
  latency 10
  : CUS -> BOF
connector E_K21 nature event_notification coupling sink
  carries "Traspaso de custodia confirmado."
  latency 10
  : CUS -> BRO
connector E_K22 nature data_flow coupling supply
  carries "Posición, rumbo y velocidad. Enlace intermitente río–tierra (celular o satelital); la Unidad a Bordo no almacena lecturas."
  : UAB -> IOT
connector E_K23 nature data_flow coupling supply
  carries "Telemetría normalizada (posiciones, estado del sello, movimientos de grúa)."
  : IOT -> SEG
connector E_K24 nature data_flow coupling sink
  carries "Histórico de posiciones y lecturas."
  : SEG -> ALT
connector E_K25 nature event_notification coupling sink
  carries "Posición, estado de navegación y novedades reportadas."
  : SEG -> BRO
connector E_K26 nature event_notification coupling sink
  carries "Eventos de custodia y de navegación."
  latency 1660
  : BRO -> TRA
connector E_K27 nature event_notification coupling sink
  carries "Traspaso de custodia en formato canónico (sale por SoS-K15)."
  latency 10
  : TRA -> FGW
connector E_K28 nature event_notification coupling supply
  carries "Posición y estado de navegación en formato canónico (sale por SoS-K16)."
  : TRA -> FGW
connector E_K29 nature event_notification coupling sink
  carries "Alertas y eventos para el operador."
  : BRO -> PAN
connector E_K30 nature dependency coupling blocking
  carries "Consulta de estado consolidado de la carga."
  : PAN -> CON
connector E_K31 nature dependency coupling blocking
  carries "Consulta de estado consolidado en modelo interno."
  : CON -> TRA
connector E_K32 nature dependency coupling blocking
  carries "Consulta de estado consolidado en formato canónico (sale por SoS-K19a)."
  latency 40000
  : TRA -> FGW
connector E_K33 nature data_flow coupling blocking
  carries "Estado consolidado de la carga consultada (llega por SoS-K19b)."
  latency 5200
  : FGW -> TRA
connector E_K34 nature data_flow coupling blocking
  carries "Estado consolidado en modelo interno."
  : TRA -> CON
connector E_K35 nature data_flow coupling blocking
  carries "Estado consolidado para mostrar al operador."
  : CON -> PAN
connector E_K36 nature data_flow coupling supply
  carries "Rumbo, velocidad y estado de navegación del remolcador."
  : REM -> UAB
connector E_K37 nature data_flow coupling supply
  carries "Estado y calado de la barcaza."
  : BAR -> UAB
connector E_K38 nature event_notification coupling sink
  carries "Novedades reportadas por el capitán (incidentes, retrasos, condiciones del río)."
  : CAP -> SEG
connector E_K39 nature dependency coupling blocking
  carries "Solicitud de capacidad de camiones para retirar carga descargada de barcazas (puerto, unidades, ventana de retiro), en modelo interno."
  : TUR -> TRA
connector E_K40 nature dependency coupling blocking
  carries "Solicitud de retiro en formato canónico (sale por SoS-K28a)."
  : TRA -> FGW
connector E_K41 nature data_flow coupling blocking
  carries "Confirmación de vehículos asignados y cita de retiro, o rechazo (llega por SoS-K28b)."
  : FGW -> TRA
connector E_K42 nature data_flow coupling blocking
  carries "Confirmación de vehículos y cita de retiro, o rechazo, en modelo interno."
  : TRA -> TUR
connector E_K43 nature dependency coupling blocking
  carries "Solicitud de capacidad de convoy fluvial para unidades liberadas en el puerto (llega por SoS-K31a)."
  : FGW -> TRA
connector E_K44 nature dependency coupling blocking
  carries "Solicitud de capacidad de convoy fluvial en modelo interno."
  : TRA -> PRO
connector E_K45 nature data_flow coupling blocking
  carries "Barcazas asignadas, muelle y ventana de cargue, o rechazo, en modelo interno."
  : PRO -> TRA
connector E_K46 nature data_flow coupling blocking
  carries "Confirmación de barcazas, muelle y ventana de cargue, o rechazo, en formato canónico (sale por SoS-K31b)."
  : TRA -> FGW

// Analyses
// E-QS3: availability of the translation (Delivery 2, 8.1.3): 99.5 %
analysis EQS3 scenario "E-QS3 (disponibilidad del Traductor)" availability target 99.9 :
  TRA
// E-QS1: custody chain E-K19, E-K20, E-K21, E-K26, E-K27 (Delivery 2, 8.1.1)
analysis EQS1 scenario "E-QS1 (custodia oportuna)" latency target 30000 :
  E_K19, E_K20, E_K21, E_K26, E_K27
// SoS-QS1 (M4): local stage of the FTS, queries + last answer + applying results (Delivery 2, 8.1.1)
analysis FTSQS1 scenario "SoS-QS1 (M4, tramo del FTS)" latency target 300000 :
  E_K32, E_K33, CON
// SoS-QS1 (M4): composition of the joint budgets, as in sos.arch
analysis SoSQS1M4 scenario "SoS-QS1 (M4)" latency target 900000 :
  RGW, SoS_K5, NCG, SoS_K32, CGW
