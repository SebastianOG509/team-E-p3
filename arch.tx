// Metamodel (M2) of the architecture description language for the SoS.
// Starting point: language of Laboratory 4. Adaptations of team E are marked [E].
Model:
  'system' name=ID
  constituents+=Constituent
  elements+=Element
  analyses*=Analysis
;

Constituent:
  'constituent' name=ID label=STRING 'owner' owner=STRING
;

Element:
  Component | Connector
;

Component:
  'component' name=ID label=STRING
  'in' system=[Constituent]
  'tier' tier=Tier
  'kind' kind=Kind
  ('availability' availability=NUMBER)?
  ('latency' latency=NUMBER)?
  ('role' role=Role)?                       // [E] architectural role of the component (C6)
  ('period' period=NUMBER)?                 // [E] heartbeat period in ms (detection time)
;

Connector:
  'connector' name=ID
  'nature' natures+=Nature[',']
  'coupling' coupling=Coupling
  'carries' info=STRING
  ('agreement' agreement=STRING)?
  ('availability' availability=NUMBER)?
  ('latency' latency=NUMBER)?
  ':' links+=Link[',']
;

Link:
  path+=[Component]['->']
;

Analysis:
  'analysis' name=ID 'scenario' scenario=STRING
  metric=Metric
  ('misses' misses=INT)?                    // [E] heartbeats that must be missed (detection)
  'target' target=NUMBER ':'
  factors+=Factor[',']
;

Factor:
  Group | Single
;

Single:
  ref=[Element]
;

// In availability, a group is a set of replicas with common-cause fraction beta (Laboratory 4).
Group:
  '[' members+=Single['|'] ']' ('beta' beta=NUMBER)?
;

Tier: 'T1' | 'T2' | 'T3' | 'T4' | 'T5';
Kind: 'hardware_software' | 'hardware' | 'software' | 'physical';
Nature: 'data_flow' | 'control_command' | 'dependency' | 'event_notification';
Coupling: 'blocking' | 'supply' | 'sink';
Role: 'broker';                                              // [E]
Metric: 'availability' | 'latency' | 'detection';            // [E] detection

Comment:
  /\/\/.*$/
;
